
{
  "name": "sonarqube-html-demo",
  "version": "1.0.0",
  "description": "HTML CSS JavaScript project for SonarQube testing",
  "private": true,
  "scripts": {
    "test": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "script.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
